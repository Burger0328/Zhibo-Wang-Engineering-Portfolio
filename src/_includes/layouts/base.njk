<!doctype html>
<html lang="en">
    <head>
        {% include "partials/head.njk" %}
    </head>

    <body class="page-{{ pageKey or 'default' }}{% if pageKey == 'home' %} intro-home{% endif %}{% if bodyClass %} {{ bodyClass }}{% endif %}">
        {% if pageKey == "home" %}
        <div class="site-intro" data-site-intro>
            <div class="intro-aurora" aria-hidden="true"></div>
            <div class="intro-grid" aria-hidden="true"></div>
            <div class="intro-giant" aria-hidden="true">ZHIBO</div>

            <div class="intro-marquee" aria-hidden="true">
                <div class="intro-marquee-track">
                    {% for copy in [1, 2] %}
                    <span>Embedded Systems</span><i>✦</i>
                    <span>Digital Hardware</span><i>✦</i>
                    <span>TinyML</span><i>✦</i>
                    <span>FPGA + VLSI</span><i>✦</i>
                    <span>Performance Engineering</span><i>✦</i>
                    {% endfor %}
                </div>
            </div>

            <div class="intro-copy">
                <p class="intro-kicker">Computer Engineering · La Jolla, California</p>
                <p class="intro-display">Where hardware<br>meets software.</p>
                <div class="intro-actions">
                    <a class="intro-enter intro-magnetic" href="#main-content" data-enter-portfolio>
                        Enter portfolio
                    </a>
                    <a class="intro-secondary intro-magnetic" href="/projects/" data-enter-portfolio>
                        View projects
                    </a>
                </div>
            </div>

            <div class="intro-meta" aria-hidden="true">
                <span>Portfolio / 2026</span>
                <span>Design · Build · Verify</span>
            </div>
        </div>
        <noscript><style>.site-intro{display:none}</style></noscript>
        {% endif %}
        <a class="skip-link" href="#main-content">Skip to main content</a>
        {% include "partials/header.njk" %}

        <main id="main-content" tabindex="-1"{% if not excludeFromSearch %} data-pagefind-body{% endif %}>
            {{ content | safe }}
        </main>

        {% include "partials/footer.njk" %}
        <script type="module" src="/js/theme-picker.js"></script>
        {% if pageKey == "home" %}<script type="module" src="/js/intro.js"></script>{% endif %}
        <script type="module" src="/js/page-transitions.js"></script>
        <script type="module" src="/js/reveal.js"></script>
        {% if pageScript %}<script type="module" src="{{ pageScript }}"></script>{% endif %}
    </body>
</html>
