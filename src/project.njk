---
layout: layouts/base.njk
pagination:
  data: projects
  size: 1
  alias: project
permalink: "/projects/{{ project.slug }}/index.html"
pageKey: projects
bodyClass: project-detail-page
eleventyComputed:
  title: "{{ project.title }}"
  description: "{{ project.summary }}"
---
<article class="project-detail">
    <p class="eyebrow">Project {{ project.number }}</p>
    <h1>{{ project.title }}</h1>
    <p class="intro">{{ project.summary }}</p>

    {% if project.image %}<img src="{{ project.image }}" alt="{{ project.alt }}" width="1536" height="1024">{% else %}<div class="project-visual project-visual-large" aria-hidden="true"><span>{{ project.number }}</span></div>{% endif %}

    <dl class="project-meta">
        <div>
            <dt>Role</dt>
            <dd>{{ project.role }}</dd>
        </div>
        <div>
            <dt>Focus</dt>
            <dd>{{ project.focus }}</dd>
        </div>
        <div><dt>Stack</dt><dd>{{ project.stack }}</dd></div>
        <div><dt>Result</dt><dd>{{ project.metric }}</dd></div>
    </dl>

    <section>
        <h2>Challenge</h2>
        <p>{{ project.challenge }}</p>
    </section>

    <section>
        <h2>Process</h2>
        <p>{{ project.process }}</p>
    </section>

    <section>
        <h2>Outcome</h2>
        <p>{{ project.outcome }}</p>
    </section>

    <p><a class="button-link" href="{{ project.repo }}">View repository on GitHub</a></p>
    <p><a href="/projects/">Return to all projects</a></p>
</article>
